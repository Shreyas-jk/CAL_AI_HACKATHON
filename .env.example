# Anthropic (Claude) — powers extract / classify / explain
ANTHROPIC_API_KEY=

# Optional model override
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Redis — session/artifact cache + embeddings. Falls back to in-memory if unset.
REDIS_URL=

# Arize — eval logging (faithfulness / hallucination). Optional; no-ops if unset.
ARIZE_API_KEY=
ARIZE_SPACE_ID=
