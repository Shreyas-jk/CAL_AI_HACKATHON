# Anthropic (Claude) — powers extract / classify / explain
ANTHROPIC_API_KEY=

# Optional model override
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Redis — session/artifact cache + embeddings. Falls back to in-memory if unset.
REDIS_URL=

# Arize — eval logging (faithfulness / hallucination). Optional; no-ops if unset.
ARIZE_API_KEY=
ARIZE_SPACE_ID=

# Sentry — error tracking + performance monitoring. Optional; no-ops if unset.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Deepgram — text-to-speech for game explanations. Optional.
DEEPGRAM_API_KEY=

# Pika — video summary generation. Optional.
PIKA_API_KEY=

# BrowserBase — fetch papers from URLs. Optional.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
